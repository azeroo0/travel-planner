DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE_NAME

# 로그인 토큰 서명 키. 예: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60

# 리뷰 분석(/analyze) 모델. OLLAMA_MODEL은 qlora 모델로 쓴다.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=hinoonyaso/exaone-tripfit:qlora-v2
OLLAMA_MODEL_BASE=exaone3.5:2.4b
OLLAMA_MODEL_LORA=

# /experiments가 읽을 평가 결과 파일
EXPERIMENTS_METRICS_PATH=evaluation/runs/2026-09-29/automatic_metrics.json
# Copy to .env and set the local password there. Do not commit .env.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=
DATABASE_URL=